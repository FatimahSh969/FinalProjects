@model IEnumerable<SmartAirPort.Models.Flight>

@{
    ViewData["Title"] = "Flights";
}

<h1>Flights</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Flight</a>
</p>

<form asp-controller="Flights" asp-action="Index" method="get" class="row g-3 mb-4">

    <div class="col-md-3">
        <label for="status" class="form-label">Flight Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Scheduled" selected="@(ViewBag.SelectedStatus as string == "Scheduled")">Scheduled</option>
            <option value="Boarding" selected="@(ViewBag.SelectedStatus as string == "Boarding")">Boarding</option>
            <option value="Departed" selected="@(ViewBag.SelectedStatus as string == "Departed")">Departed</option>
            <option value="Arrived" selected="@(ViewBag.SelectedStatus as string == "Arrived")">Arrived</option>
            <option value="Delayed" selected="@(ViewBag.SelectedStatus as string == "Delayed")">Delayed</option>
            <option value="Cancelled" selected="@(ViewBag.SelectedStatus as string == "Cancelled")">Cancelled</option>
        </select>
    </div>

    <div class="col-md-3">
        <label for="airlineId" class="form-label">Airline</label>
        <select id="airlineId" name="airlineId"
                asp-items="ViewBag.AirlineList" class="form-select">
            <option value="">All Airlines</option>
        </select>
    </div>

    <div class="col-md-3">
        <label for="aircraftId" class="form-label">Aircraft</label>
        <select id="aircraftId" name="aircraftId"
                asp-items="ViewBag.AircraftList" class="form-select">
            <option value="">All Aircraft</option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-controller="Flights" asp-action="Index"
           class="btn btn-secondary">Reset</a>
    </div>

</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FlightNumber)</th>
            <th>@Html.DisplayNameFor(model => model.ArrivalAirport)</th>
            <th>@Html.DisplayNameFor(model => model.DepartureAirport)</th>
            <th>@Html.DisplayNameFor(model => model.DepartureTime)</th>
            <th>@Html.DisplayNameFor(model => model.ArrivalTime)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>Airline</th>
            <th>Aircraft</th>
            <th>Gate</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(model => item.FlightNumber)</td>
                <td>@Html.DisplayFor(model => item.ArrivalAirport)</td>
                <td>@Html.DisplayFor(model => item.DepartureAirport)</td>
                <td>@Html.DisplayFor(model => item.DepartureTime)</td>
                <td>@Html.DisplayFor(model => item.ArrivalTime)</td>

                <td>
                    @if (item.Status == "Scheduled")
                    {
                        <span class="badge bg-success">Scheduled</span>
                    }
                    else if (item.Status == "Boarding")
                    {
                        <span class="badge bg-warning text-dark">Boarding</span>
                    }
                    else if (item.Status == "Departed")
                    {
                        <span class="badge bg-danger">Departed</span>
                    }
                    else if (item.Status == "Arrived")
                    {
                        <span class="badge bg-secondary">Arrived</span>
                    }
                    else if (item.Status == "Delayed")
                    {
                        <span class="badge bg-warning text-dark">Delayed</span>
                    }
                    else if (item.Status == "Cancelled")
                    {
                        <span class="badge bg-dark">Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>

                <td>@(item.Airline?.Name ?? "Not assigned")</td>
                <td>@(item.Aircraft?.RegistrationNumber ?? "Not assigned")</td>
                <td>@(item.Gate?.GateNumber ?? "Not assigned")</td>

                <td>
                    <div class="action-buttons">
                        <a asp-controller="Flights"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">Edit</a>

                        <a asp-controller="Flights"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-secondary">Details</a>

                        <a asp-controller="Flights"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No flights found matching your filters.
    </div>
}
