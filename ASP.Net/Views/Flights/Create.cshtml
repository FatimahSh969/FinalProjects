
@model SmartAirPort.Models.Flight

@{
    ViewData["Title"] = "Create Flight";
}

<div class="container-fluid">

    <h2>Create Flight</h2>
    <p class="text-muted">Enter the flight information below</p>
    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="form-group mb-3">
                    <label asp-for="FlightNumber" class="control-label"></label>
                    <input asp-for="FlightNumber" class="form-control" />
                    <span asp-validation-for="FlightNumber" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DepartureAirport" class="control-label"></label>
                    <input asp-for="DepartureAirport" class="form-control" />
                    <span asp-validation-for="DepartureAirport" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ArrivalAirport" class="control-label"></label>
                    <input asp-for="ArrivalAirport" class="form-control" />
                    <span asp-validation-for="ArrivalAirport" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DepartureTime" class="control-label"></label>
                    <input asp-for="DepartureTime"
                           type="datetime-local"
                           class="form-control" />
                    <span asp-validation-for="DepartureTime" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ArrivalTime" class="control-label"></label>
                    <input asp-for="ArrivalTime"
                           type="datetime-local"
                           class="form-control" />
                    <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Status" class="control-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Scheduled">Scheduled</option>
                        <option value="Boarding">Boarding</option>
                        <option value="Departed">Departed</option>
                        <option value="Arrived">Arrived</option>
                        <option value="Delayed">Delayed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AirlineId" class="control-label">Airline</label>
                    <select asp-for="AirlineId"
                            asp-items="ViewBag.AirlineList"
                            class="form-select">
                        <option value="">Select Airline</option>
                    </select>
                    <span asp-validation-for="AirlineId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="AircraftId" class="control-label">Aircraft</label>
                    <select asp-for="AircraftId"
                            asp-items="ViewBag.AircraftList"
                            class="form-select">
                        <option value="">Select Aircraft (Optional)</option>
                    </select>
                    <span asp-validation-for="AircraftId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="GateId" class="control-label">Gate</label>
                    <select asp-for="GateId"
                            asp-items="ViewBag.GateList"
                            class="form-select">
                        <option value="">Select Gate (Optional)</option>
                    </select>
                    <span asp-validation-for="GateId" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        Create Flight
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Back to List
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}