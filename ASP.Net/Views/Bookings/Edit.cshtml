@model SmartAirPort.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container-fluid">
    <h2 class="mb-2">Edit Booking</h2>
    <p class="text-muted mb-4">
        Update passenger booking information
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Booking Reference</label>
                    <input value="@Model.BookingReference"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="PassengerName"
                           class="form-label">Passenger Name</label>

                    <input asp-for="PassengerName"
                           class="form-control" />

                    <span asp-validation-for="PassengerName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PassengerIdNumber"
                           class="form-label">ID / Passport Number</label>

                    <input asp-for="PassengerIdNumber"
                           class="form-control" />

                    <span asp-validation-for="PassengerIdNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactNumber"
                           class="form-label">Contact Number</label>

                    <input asp-for="ContactNumber"
                           class="form-control" />

                    <span asp-validation-for="ContactNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FlightId"
                           class="form-label">Select Flight</label>

                    <select asp-for="FlightId"
                            asp-items="ViewBag.FlightId"
                            class="form-select">
                        <option value="">-- Select Flight --</option>
                    </select>

                    <span asp-validation-for="FlightId"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
