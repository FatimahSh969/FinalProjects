@{
    ViewData["Title"] = "Flight Schedule";
}

<div class="container-fluid py-4 bg-light min-vh-100">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

        <div>
            <h2 class="fw-bold mb-1">Flight Schedule</h2>
            <p class="text-muted mb-0">
                View and monitor airport flight schedules
            </p>
        </div>

        <a asp-controller="Flights"
           asp-action="Index"
           class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i>
            Back to Flights
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-wrap gap-3 mb-4">

                <span>
                    <span class="badge rounded-circle"
                          style="background-color:#0d6efd;">&nbsp;</span>
                    Scheduled
                </span>

                <span>
                    <span class="badge rounded-circle"
                          style="background-color:#ffc107;">&nbsp;</span>
                    Boarding
                </span>

                <span>
                    <span class="badge rounded-circle"
                          style="background-color:#0dcaf0;">&nbsp;</span>
                    Departed
                </span>

                <span>
                    <span class="badge rounded-circle"
                          style="background-color:#198754;">&nbsp;</span>
                    Arrived
                </span>

                <span>
                    <span class="badge rounded-circle"
                          style="background-color:#dc3545;">&nbsp;</span>
                    Delayed
                </span>

                <span>
                    <span class="badge rounded-circle"
                          style="background-color:#6c757d;">&nbsp;</span>
                    Cancelled
                </span>

            </div>

            <div id="flightCalendar"></div>

        </div>
    </div>

</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.css"
      rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>

<script>

    document.addEventListener('DOMContentLoaded', function () {

        const calendarElement = document.getElementById('flightCalendar');

        const calendar = new FullCalendar.Calendar(calendarElement, {

            initialView: 'dayGridMonth',

            height: 'auto',

            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },

            buttonText: {
                today: 'Today',
                month: 'Month',
                week: 'Week',
                day: 'Day'
            },

            events: {
                url: '@Url.Action("GetFlightEvents", "FlightCalendar")',
                method: 'GET'
            },

            eventTimeFormat: {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            },

            eventClick: function (info) {

                const flight = info.event;

                const props = flight.extendedProps;

                const departure = props.departureAirport ?? 'N/A';
                const arrival = props.arrivalAirport ?? 'N/A';
                const status = props.status ?? 'N/A';

                alert(
                    'Flight: ' + flight.title +
                    '\nStatus: ' + status +
                    '\nDeparture: ' + departure +
                    '\nArrival: ' + arrival
                );

            },

            dayMaxEvents: true,

            nowIndicator: true

        });

        calendar.render();

    });

</script>
